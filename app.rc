// ============================================================
// app.rc —— Windows 资源脚本
// 作用：
//   1. 为 exe 嵌入程序图标（取自 src/ui/assets/cover.ico）
//   2. 写入版本信息，供资源管理器 / 属性页显示
//
// 注意：CMakeLists.txt 的 add_executable() 直接引用了本文件，
//       缺失会导致 cmake configure 阶段报 "Cannot find source file"。
//
// 编码：本文件以 UTF-8（无 BOM）保存，中文版权信息必须显式声明代码页，
//       否则两个编译器都会按本地 ANSI（GBK）解码成乱码：
//         - MSVC  rc.exe  → 靠下面的 #pragma code_page(65001)
//         - MinGW windres → 靠 CMakeLists.txt 传入的 -c 65001
//       两处缺一不可，改动这里时别删。
// ============================================================

#pragma code_page(65001)

#include <windows.h>

// 显式定义资源 ID。若不 define，rc 会把 IDI_APPICON 当成字符串资源名，
// 导致 LoadIcon(MAKEINTRESOURCE(...)) 取不到。
#define IDI_APPICON 101

// ---- 程序图标（任务栏 / 资源管理器 / Alt+Tab）----
IDI_APPICON ICON "src/ui/assets/cover.ico"

// ---- 版本信息 ----
VS_VERSION_INFO VERSIONINFO
 FILEVERSION     2,0,0,0
 PRODUCTVERSION  2,0,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 = en-US, 04B0 = Unicode
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "萌萌_Rock"
            VALUE "FileDescription",  "OnePiece"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "InternalName",     "OnePiece"
            VALUE "LegalCopyright",   "© 2026 萌萌_Rock. All rights reserved."
            VALUE "OriginalFilename", "OnePiece.exe"
            VALUE "ProductName",      "OnePiece"
            VALUE "ProductVersion",   "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
